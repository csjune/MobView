{
  "name": "mobview",
  "version": "0.1.1",
  "private": true,
  "description": "Firefox extension that switches chosen sites to their mobile view with one click",
  "license": "MPL-2.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --source-dir src",
    "start": "web-ext run --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --filename mobview-{version}.xpi --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
